# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- LLM provider -----------------------------------------------------------
AGENTIC_RAG_OPENAI_API_KEY=
AGENTIC_RAG_LLM_MODEL=gpt-4o-mini

# --- Document parsing -------------------------------------------------------
AGENTIC_RAG_LLAMA_CLOUD_API_KEY=

# --- Vector store -----------------------------------------------------------
AGENTIC_RAG_CHROMA_DIR=./.chroma
AGENTIC_RAG_COLLECTION_NAME=corpus
AGENTIC_RAG_RETRIEVAL_K=5

# --- Graph control ----------------------------------------------------------
AGENTIC_RAG_GROUNDEDNESS_THRESHOLD=0.7
AGENTIC_RAG_PRECISION_THRESHOLD=0.7
AGENTIC_RAG_MAX_ITERATIONS=3

# --- Safety filter ----------------------------------------------------------
# Off by default. See docs/architecture.md for why.
AGENTIC_RAG_ENABLE_SAFETY_FILTER=false
AGENTIC_RAG_SAFETY_MODEL=

# --- Observability ----------------------------------------------------------
AGENTIC_RAG_LOG_LEVEL=INFO
AGENTIC_RAG_LOG_FORMAT=text
